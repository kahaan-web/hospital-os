# Hospital OS — development environment. Copy to `.env` (git-ignored). Dev-only values; never reuse in production.

# --- Postgres (Docker, host port 55432) ---
POSTGRES_SUPERUSER_PASSWORD=hos_dev_superuser
# Bootstrap/superuser connection: used ONLY by `npm run db:migrate` to create the two roles below.
DATABASE_ADMIN_URL=postgres://postgres:hos_dev_superuser@127.0.0.1:55432/hospital_os
# Migration role: owns the schema, runs migrations and seeds. Not a superuser, no BYPASSRLS.
DATABASE_MIGRATION_URL=postgres://hos_migrator:hos_dev_migrator@127.0.0.1:55432/hospital_os
# Application role: what the API connects as. Not a superuser, no BYPASSRLS, subject to row-level security.
DATABASE_URL=postgres://hos_app:hos_dev_app@127.0.0.1:55432/hospital_os

# --- API / web ---
API_PORT=4400
WEB_PORT=3400
WEB_ORIGIN=http://localhost:3400
API_ORIGIN=http://127.0.0.1:4400
UPLOAD_DIR=./uploads

# --- Mock providers (no real gateway / SMS / email in Phase A) ---
MOCK_GATEWAY_KEY_ID=mock_key_hospitalos_dev
MOCK_GATEWAY_KEY_SECRET=mock_secret_change_me_dev_only
MOCK_GATEWAY_WEBHOOK_SECRET=mock_webhook_secret_dev_only
# When true, mock OTP codes and invite links are echoed in API responses (and always in the API log).
MOCK_EXPOSE_SECRETS=true

# --- Demo App Admin (seeded; dev only) ---
SEED_ADMIN_EMAIL=admin@hospitalos.test
SEED_ADMIN_PASSWORD=Admin@12345
