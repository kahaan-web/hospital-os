# API origin (no trailing slash). Paths are under /api/v1.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4400

# 1 (default) uses in-app fictional fixtures. Set to 0 to call the real API.
EXPO_PUBLIC_USE_MOCK=1

# Optional later: build a single Android app (patient | doctor | nurse | mis | equipment | hr | maintenance).
# EXPO_PUBLIC_APP_VARIANT=patient
